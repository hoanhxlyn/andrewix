{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "stylix"
  },
  "plugins": [
    "@streetturtle/opencode-recap",
    "opencode-plugin-usage",
    "opencode-bubble-tabs",
    "opencode-ghost"
  ],
  "animations": true,
  "session": {
    "permissions": "prompt",
    "sidebar": "auto",
    "image_preview": true,
    "scrollbar": true,
    "thinking": "hide",
    "verbosity": "low",
    "grouping": "auto",
    "markdown": "rendered"
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
