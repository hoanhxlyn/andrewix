{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.css.ts",
    "./src/atoms/theme.ts",
    "./src/root.tsx"
  ],
  "scripts": {
    "dev": "bunx --bun react-router dev",
    "build": "bunx --bun react-router build",
    "deploy": "bun run build && bunx wrangler pages deploy",
    "preview": "bunx --bun vite preview --outDir build/client",
    "walls": "bun scripts/gen-walls.ts",
    "test": "bun test",
    "e2e": "playwright test",
    "lint": "biome lint --write --unsafe .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@catppuccin/palette": "^1.8.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@formkit/auto-animate": "0.10.0",
    "@shikijs/rehype": "^4.5.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "isbot": "^5.2.2",
    "jotai": "^3.0.1",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.54.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "unplugin-fonts": "^2.1.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5"
  }
}
